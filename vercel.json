{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "includeFiles": "assets/**"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://ryanschmidt.design; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/inventory", "destination": "/pages/inventory.html" },
    { "source": "/ai-coding-portfolio", "destination": "/pages/ai-coding-portfolio.html" },
    { "source": "/member-portal-overhaul", "destination": "/pages/member-portal-overhaul.html" },
    { "source": "/about.html", "destination": "/pages/about.html" },
    { "source": "/dashboard.html", "destination": "/pages/dashboard.html" },
    { "source": "/inventory.html", "destination": "/pages/inventory.html" },
    { "source": "/ai-coding-portfolio.html", "destination": "/pages/ai-coding-portfolio.html" },
    { "source": "/member-portal-overhaul.html", "destination": "/pages/member-portal-overhaul.html" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ryanschmidt.design"
        }
      ],
      "destination": "https://ryanschmidt.design/:path",
      "permanent": true
    },
    {
      "source": "/design-system.html",
      "destination": "/ai-coding-portfolio.html",
      "permanent": true
    },
    {
      "source": "/portfolio-kb.json",
      "destination": "/assets/portfolio-kb.json",
      "permanent": true
    },
    {
      "source": "/llms.txt",
      "destination": "/assets/llms.txt",
      "permanent": true
    },
    {
      "source": "/llms-full.txt",
      "destination": "/assets/llms-full.txt",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-october-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-october-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-september-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-september-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-august-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-august-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-june-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/resume.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": false
    }
  ]
}
