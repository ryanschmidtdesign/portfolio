{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "includeFiles": "assets/portfolio-kb.json"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(llms.txt|llms-full.txt|portfolio-kb.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(images|icons)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://ryanschmidt.design; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/portfolio-kb.json", "destination": "/assets/portfolio-kb.json" },
    { "source": "/llms.txt", "destination": "/assets/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/assets/llms-full.txt" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ryanschmidt.design"
        }
      ],
      "destination": "https://ryanschmidt.design/:path",
      "permanent": true
    },
    { "source": "/about", "destination": "/pages/about", "permanent": true },
    { "source": "/about.html", "destination": "/pages/about", "permanent": true },
    { "source": "/dashboard", "destination": "/pages/dashboard", "permanent": true },
    { "source": "/dashboard.html", "destination": "/pages/dashboard", "permanent": true },
    { "source": "/inventory", "destination": "/pages/inventory", "permanent": true },
    { "source": "/inventory.html", "destination": "/pages/inventory", "permanent": true },
    { "source": "/ai-coding-portfolio", "destination": "/pages/ai-coding-portfolio", "permanent": true },
    { "source": "/ai-coding-portfolio.html", "destination": "/pages/ai-coding-portfolio", "permanent": true },
    { "source": "/member-portal-overhaul", "destination": "/pages/member-portal-overhaul", "permanent": true },
    { "source": "/member-portal-overhaul.html", "destination": "/pages/member-portal-overhaul", "permanent": true },
    {
      "source": "/design-system",
      "destination": "/pages/ai-coding-portfolio",
      "permanent": true
    },
    {
      "source": "/design-system.html",
      "destination": "/pages/ai-coding-portfolio",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-october-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-october-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-september-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-september-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-august-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/ryan-schmidt-resume-august-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/assets/ryan-schmidt-resume-june-2026.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": true
    },
    {
      "source": "/resume.pdf",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/assets/ryan-schmidt-resume.pdf",
      "permanent": false
    }
  ]
}
