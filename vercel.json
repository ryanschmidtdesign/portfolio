{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "includeFiles": "assets/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://generativelanguage.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://ryanschmidt.design; connect-src 'self' https://generativelanguage.googleapis.com https://ggmkmymtilpkezkpihxt.supabase.co https://r.jina.ai https://www.googleapis.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about.html", "destination": "/pages/about.html" },
    { "source": "/dashboard.html", "destination": "/pages/dashboard.html" },
    { "source": "/inventory.html", "destination": "/pages/inventory.html" },
    { "source": "/ai-coding-portfolio.html", "destination": "/pages/ai-coding-portfolio.html" },
    { "source": "/member-portal-overhaul.html", "destination": "/pages/member-portal-overhaul.html" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ryanschmidt.design"
        }
      ],
      "destination": "https://ryanschmidt.design/:path",
      "permanent": true
    },
    {
      "source": "/design-system.html",
      "destination": "/ai-coding-portfolio.html",
      "permanent": true
    },
    {
      "source": "/portfolio-kb.json",
      "destination": "/assets/portfolio-kb.json",
      "permanent": true
    },
    {
      "source": "/llms.txt",
      "destination": "/assets/llms.txt",
      "permanent": true
    }
  ]
}
