<!doctype html>
<html lang="en">
<head>
  <!-- Core -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="preconnect" href="https://generativelanguage.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://ryanschmidt.design">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="Ryan Schmidt">

  <!-- SEO hygiene -->
  <link rel="canonical" href="https://ryanschmidt.design{{ page.url }}">
  <meta name="robots" content="index,follow,max-image-preview:large">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Ryan Schmidt — Senior B2B SaaS Product Designer & UX Engineer">
  <meta property="og:title" content="{{ og_title | default(title) }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://ryanschmidt.design{{ page.url }}">
  <meta property="og:image" content="{{ og_image | default('https://ryanschmidt.design/assets/logo/og-image.png') }}">
  <meta property="og:image:alt" content="{{ og_image_alt | default('Ryan Schmidt — Senior B2B SaaS Product Designer & UX Engineer. Brand mark of two overlapping hexagons.') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | default(title) }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ og_image | default('https://ryanschmidt.design/assets/logo/og-image.png') }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt | default('Ryan Schmidt - Senior B2B SaaS Product Designer & UX Engineer, Austin TX') }}">

  <!-- Browser behavior / UX -->
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="format-detection" content="telephone=no">
  <meta name="application-name" content="Ryan Schmidt">
  <meta name="apple-mobile-web-app-title" content="Ryan Schmidt">
  <meta name="theme-color" content="#F5F5F5">

  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- Performance hints -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/layout.css?v=2">
  <link rel="stylesheet" href="/css/components.css?v=4">
  <link rel="stylesheet" href="/css/pages.css?v=4">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/github.min.css">
</head>
<body class="{{ body_class }}">
  <main id="main" class="{% if is_home %}home-gallery{% endif %}">
    {{ content | safe }}

    <div class="ai-mini-wrapper consolidated-nav" data-assistant-trigger>
      <nav class="ai-mini-nav" aria-label="Main navigation">
        <a href="/" {% if is_home %}aria-current="page"{% endif %}>Home</a>
        <a href="/pages/about.html" {% if page.url == '/pages/about.html' %}aria-current="page"{% endif %}>About</a>
        <div class="menu-item-group">
          <button class="menu-trigger" aria-haspopup="true" aria-expanded="false">Case Studies</button>
          <div class="menu-submenu">
            <a href="/pages/dashboard.html" {% if page.url == '/pages/dashboard.html' %}aria-current="page"{% endif %}>AI‑Powered Dashboards</a>
            <a href="/pages/inventory.html" {% if page.url == '/pages/inventory.html' %}aria-current="page"{% endif %}>Real-Time Inventory</a>
            <a href="/pages/member-portal-overhaul.html" {% if page.url == '/pages/member-portal-overhaul.html' %}aria-current="page"{% endif %}>Member Portal Redesign</a>
            <a href="/pages/ai-coding-portfolio.html" {% if page.url == '/pages/ai-coding-portfolio.html' %}aria-current="page"{% endif %}>Engineering My Portfolio</a>
          </div>
        </div>
        <a href="/assets/ryan-schmidt-resume-september-2026.pdf" target="_blank" rel="noopener">Resume</a>
      </nav>
      <div class="ai-mini-input-container">
        <input type="text" id="ai-mini-input" class="ai-mini-input"
          placeholder="Ask how Ryan’s work demonstrates role fit, product strategy, or case-study impact..."
          autocomplete="off" aria-label="Ask about Ryan's work, case studies, or role fit" />
        <button id="ai-mini-send" class="ai-mini-send" aria-label="Send">→</button>
      </div>
    </div>

    {% if is_home %}
    <!-- Homepage case study titles -->
    <script src="/scripts/home-titles.js?v=3" defer></script>
    {% endif %}

    <!-- Consolidated JavaScript -->
    <script src="/scripts/scripts.js?v=3" defer></script>

    <!-- NLI Connection Logic -->
    <script>
      (function () {
        const miniInput = document.getElementById('ai-mini-input');
        if (miniInput) miniInput.addEventListener('keypress', function (e) {
          if (e.key === 'Enter') {
            const query = miniInput.value.trim();
            if (!query) return;
            miniInput.value = '';
            const trigger = document.querySelector('[data-assistant-trigger]');
            if (trigger) trigger.click();
            setTimeout(() => {
              document.dispatchEvent(new CustomEvent("rs:ask-section", {
                detail: {
                  prompt: query,
                  sectionContext: { heading: "Global Navigation NLI" }
                }
              }));
            }, 300);
          }
        });
      })();
    </script>

    <script src="/scripts/rs-chat-widget.js?v=3" defer></script>
  </main>
  <footer class="site-footer">
    <a class="site-footer-brand" href="/">
      <img src="/favicon.svg?v=2" width="16" height="16" alt="" aria-hidden="true">
      Ryan Schmidt — Senior B2B SaaS Product Designer &amp; UX Engineer
    </a>
    <p>&copy; 2026 Ryan Schmidt</p>
  </footer>
  {% if is_home %}
  <script>
    // Ensure the homepage puts the AI input first and avoids duplicate cards.
    (function () {
      document.addEventListener('DOMContentLoaded', function () {
        try {
          // Hamburger menu entrance stagger
          const hamburger = document.getElementById('hamburger');
          const menu = document.getElementById('hamburgerMenu');
          if (hamburger && menu) {
            menu.querySelectorAll('a').forEach((link, index) => {
              link.style.transitionDelay = `${index * 20}ms`;
            });
          }
        } catch (e) {
          console.error('Homepage DOM safety script error', e);
        }
      });
    })();
  </script>
  {% endif %}
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => { });
      });
    }
  </script>
</body>
</html>
